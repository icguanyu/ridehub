# ── 伺服器 ─────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# 允許的前端來源（逗號分隔）
CORS_ORIGINS=http://localhost:5173

# ── Supabase ──────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── JWT（司機登入 token）─────────────────
JWT_SECRET=請換成一組長亂數
JWT_EXPIRY=7d

# ── LINE Messaging API ────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 官方帳號「加好友」連結（lin.ee/xxxx 或 https://line.me/R/ti/p/@xxxx），顯示在司機綁定畫面
LINE_ADD_FRIEND_URL=

# ── Email（SendGrid，選用）────────────
SENDGRID_API_KEY=
