# ── 伺服器 ─────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# 允許的前端來源（逗號分隔）
CORS_ORIGINS=http://localhost:5173
# 營運時區（IANA 名稱）。所有「今天 / 現在」判斷以此為準。例：Asia/Taipei、Europe/Berlin
APP_TIMEZONE=Asia/Taipei

# ── Supabase ──────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── JWT（司機登入 token）─────────────────
JWT_SECRET=請換成一組長亂數
JWT_EXPIRY=7d

# ── superadmin 後台 ───────────────────
# 允許登入 /admin 的 email（逗號分隔）。需是 Supabase Auth 既有帳號。空 = 停用
ADMIN_EMAILS=

# ── LINE Messaging API ────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 官方帳號「加好友」連結（lin.ee/xxxx 或 https://line.me/R/ti/p/@xxxx），顯示在司機綁定畫面
LINE_ADD_FRIEND_URL=

# ── Google Maps（距離自動估算，選用）──
# 需開通 Distance Matrix API。未填則不做自動估算。
GOOGLE_MAPS_API_KEY=

# ── Email（SendGrid，選用）────────────
SENDGRID_API_KEY=
