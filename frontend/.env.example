# 後端 API base（含 /api/v1）
VITE_API_BASE_URL=http://localhost:3001/api/v1

# 營運時區（IANA 名稱），必須和後端 APP_TIMEZONE 一致
VITE_APP_TIMEZONE=Asia/Taipei

# Supabase — 目前前端沒有直連 Supabase（全部走後端 API），這兩個變數用不到、
# 也不會被打包進 bundle。等未來要做前端直連 Realtime 時再填，
# 且填之前務必確認每一張表都已 enable RLS。
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
