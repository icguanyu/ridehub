# 後端 API base（含 /api/v1）
VITE_API_BASE_URL=http://localhost:3001/api/v1

# 營運時區（IANA 名稱），必須和後端 APP_TIMEZONE 一致
VITE_APP_TIMEZONE=Asia/Taipei

# Supabase — 前端僅用於「忘記密碼 / 重設密碼」的 Supabase Auth 流程。
# anon key 可公開，但前提是每張表都已 enable RLS（見 migrations）。
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
